# Copy to .env (dev) and .env.test (tests, pointing at fairshare_test).
# Percent-encode reserved characters in the password (< -> %3C, > -> %3E, @ -> %40, # -> %23, % -> %25, / -> %2F, : -> %3A).
DATABASE_URL="postgresql://fairshare:<url-encoded-password>@localhost:5432/fairshare_dev?schema=public"
PORT=3000
SIM_SEED=42
